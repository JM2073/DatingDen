@page "/"
@implements IDisposable
@inject PlannerApiClient Api
@inject PlannerRepository Repository
@inject PlannerState State

<PageTitle>Relationship Planner</PageTitle>

<MudStack Spacing="3" Class="home-stack">
    <MudPaper Elevation="1" Class="hero-panel pa-6">
        <MudStack Spacing="3">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">Relationship planner</MudChip>
            <MudText Typo="Typo.h3" Class="hero-title">@_settings.CoupleName</MudText>
            <MudText Typo="Typo.body1" Class="hero-copy">
                Shared calendar, personal colors, relationship milestones, and notes in one Blazor app.
            </MudText>

            <MudStack Row="true" Spacing="2" Class="hero-actions">
                <MudButton Href="/planner" Variant="Variant.Filled" Color="Color.Primary">Open planner</MudButton>
                <MudButton Href="/finance" Variant="Variant.Outlined" Color="Color.Primary">Open finance</MudButton>
                <MudButton Href="/settings" Variant="Variant.Outlined" Color="Color.Primary">Settings</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <div class="home-top-row">
        <div class="metric-grid">
                <MudPaper Elevation="1" Class="metric-card pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Entries</MudText>
                <MudText Typo="Typo.h4">@_summary.TotalEntries</MudText>
                <MudText Typo="Typo.body2">Everything saved in the shared planner.</MudText>
            </MudPaper>
                <MudPaper Elevation="1" Class="metric-card pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Time together</MudText>
                <MudText Typo="Typo.h4">@_timeTogether</MudText>
                <MudText Typo="Typo.body2">@_relationshipLine</MudText>
            </MudPaper>
            <MudPaper Elevation="1" Class="metric-card pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Active user</MudText>
                <MudText Typo="Typo.h4">@_activeUser.Name</MudText>
                <MudText Typo="Typo.body2">Color: @_activeUser.AccentColor</MudText>
            </MudPaper>
            <MudPaper Elevation="1" Class="metric-card pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Games</MudText>
                <MudText Typo="Typo.h4">@_gameSummary.GameEntries</MudText>
                <MudText Typo="Typo.body2">Tracked for the active user.</MudText>
            </MudPaper>
            <MudPaper Elevation="1" Class="metric-card pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Finance</MudText>
                <MudText Typo="Typo.h4">@FormatMoney(_financeSummary.NetBudget)</MudText>
                <MudText Typo="Typo.body2">@_financeSummary.ItemCount lines this month.</MudText>
            </MudPaper>
        </div>

        <MudPaper Elevation="1" Class="side-panel pa-5">
            <MudText Typo="Typo.h5">What lives here</MudText>
            <MudDivider Class="my-3" />
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.CalendarMonth">Calendar and selected-day entries</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.People">User profiles and colors</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Settings">Shared settings</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Checklist">Notes, reminders, memories, and countdowns</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalanceWallet">Monthly budgets and finance lines</MudListItem>
            </MudList>
        </MudPaper>
    </div>

    <MudPaper Elevation="1" Class="roadmap-panel pa-5">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h5">Recent entries</MudText>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@_entries.Count</MudChip>
            </MudStack>

            @if (_entries.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    Nothing saved yet. Open the planner and add the first entry.
                </MudAlert>
            }
            else
            {
                <div class="recent-grid">
                    @foreach (var entry in _entries.Take(3))
                    {
                        <MudCard Class="roadmap-card" Style="@GetEntryCardStyle(entry.Kind)">
                            <MudCardContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudChip T="string" Variant="Variant.Filled" Style="@GetKindChipStyle(entry.Kind)">@GetKindLabel(entry.Kind)</MudChip>
                                    <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text">@GetUserName(entry.UserId)</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.h6" Class="mt-2">@entry.Title</MudText>
                                <MudText Typo="Typo.body2">@entry.Notes</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                    @(entry.TargetDate?.ToString("dd MMM yyyy") ?? "No date")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    }
                </div>
            }
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private PlannerSummary _summary = new();
    private PlannerSummary _gameSummary = new();
    private FinanceSummary _financeSummary = new();
    private PlannerSettings _settings = new();
    private PlannerUser _activeUser = new() { Name = "You", AccentColor = "#c3252d" };
    private List<PlannerUser> _users = [];
    private List<PlannerEntry> _entries = [];
    private string _timeTogether = "n/a";
    private string _relationshipLine = "Set a relationship start date in settings.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _summary = await Api.GetSummaryAsync();
        _settings = await Api.GetSettingsAsync();
        _users = (await Api.GetUsersAsync()).ToList();
        _entries = (await Api.GetEntriesAsync()).ToList();
        var currentUserId = GetCurrentUserId();
        _gameSummary = await Api.GetGameSummaryAsync(currentUserId);
        _financeSummary = await Repository.GetFinanceSummaryAsync(currentUserId, new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1));
        _activeUser = _users.FirstOrDefault(x => x.Id == currentUserId) ?? _users.FirstOrDefault() ?? _activeUser;

        if (_settings.RelationshipStart is DateOnly start)
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var years = today.Year - start.Year;
            var months = today.Month - start.Month;
            var days = today.Day - start.Day;
            if (days < 0)
            {
                months--;
                days += DateTime.DaysInMonth(today.AddMonths(-1).Year, today.AddMonths(-1).Month);
            }
            if (months < 0)
            {
                years--;
                months += 12;
            }
            _timeTogether = $"{Math.Max(years, 0)}y {Math.Max(months, 0)}m {Math.Max(days, 0)}d";
            _relationshipLine = $"Since {start:dd MMM yyyy}";
        }
        else
        {
            _timeTogether = "n/a";
            _relationshipLine = "Set a relationship start date in settings.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetUserName(int userId)
    {
        return _users.FirstOrDefault(user => user.Id == userId)?.Name ?? "Shared";
    }

    private static string FormatMoney(decimal value) => value.ToString("C", System.Globalization.CultureInfo.CurrentCulture);

    private static string GetKindLabel(string? kind) => kind switch
    {
        "date" => "Date idea",
        "reminder" => "Reminder",
        "countdown" => "Countdown",
        "memory" => "Memory",
        "got_together" => "Got together",
        "game_plan" => "Game plan",
        "game_status" => "Game status",
        _ => "Entry"
    };

    private string GetEntryCardStyle(string? kind)
    {
        var color = GetKindColor(kind);
        return $"border-left-color:{color};";
    }

    private string GetKindChipStyle(string? kind)
    {
        var color = GetKindColor(kind);
        return $"background:{color};color:#fff;";
    }

    private string GetKindColor(string? kind) => kind switch
    {
        "date" => _settings.DateIdeaColor,
        "reminder" => _settings.ReminderColor,
        "countdown" => _settings.CountdownColor,
        "memory" => _settings.MemoryColor,
        "got_together" => _settings.GotTogetherColor,
        "game_plan" => _settings.DateIdeaColor,
        "game_status" => _settings.FinishedColor,
        _ => _settings.DateIdeaColor
    };

    private int GetCurrentUserId()
    {
        return State.SelectedUserId ?? _settings.ActiveUserId;
    }

    private void OnPlannerStateChanged()
    {
        _ = LoadAsync();
    }

    protected override void OnInitialized()
    {
        State.Changed += OnPlannerStateChanged;
    }

    public void Dispose()
    {
        State.Changed -= OnPlannerStateChanged;
    }
}

