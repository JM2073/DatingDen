@page "/settings"
@implements IDisposable
@inject PlannerApiClient Api
@inject PlannerState State
@inject NavigationManager Navigation
@inject UserSessionService Session

<PageTitle>Settings</PageTitle>

<MudStack Spacing="3">
    <MudPaper Elevation="1" Class="pa-5">
        <MudText Typo="Typo.h4">Settings</MudText>
        <MudText Typo="Typo.body1" Class="muted mt-2">
            Shared planner details live here, along with per-user profiles and colors.
        </MudText>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudPaper Elevation="1" Class="pa-5">
                <MudText Typo="Typo.h6">Shared relationship settings</MudText>
                <MudStack Spacing="2" Class="mt-3">
                    <MudTextField @bind-Value="_settings.CoupleName" Label="Couple or project name" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="_settings.RelationshipStartText"
                                  Label="Relationship start date"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Date" />
                    <MudTextField @bind-Value="_settings.DefaultReminderDaysText"
                                  Label="Default reminder days"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Number" />
                    <MudSelect T="string" @bind-Value="_settings.Theme" Label="Theme" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("system")">System</MudSelectItem>
                        <MudSelectItem T="string" Value="@("light")">Light</MudSelectItem>
                        <MudSelectItem T="string" Value="@("dark")">Dark</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" Value="@_settings.VisualTheme" ValueChanged="OnVisualThemeChanged" Label="Style theme" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("persona")">Persona</MudSelectItem>
                        <MudSelectItem T="string" Value="@("rwby")">RWBY</MudSelectItem>
                        <MudSelectItem T="string" Value="@("pokemon")">Pokémon</MudSelectItem>
                        <MudSelectItem T="string" Value="@("dnd")">D&D</MudSelectItem>
                        <MudSelectItem T="string" Value="@("cozy")">Cozy romance</MudSelectItem>
                        <MudSelectItem T="string" Value="@("retro")">Retro arcade</MudSelectItem>
                    </MudSelect>
                    <MudTextField @bind-Value="_settings.RawgApiKey"
                                  Label="RAWG API key"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />
                    <MudTextField @bind-Value="_settings.SteamWebApiKey"
                                  Label="Steam web API key"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password" />
                    <MudSelect T="int" @bind-Value="_settings.ActiveUserId" Label="Active user" Variant="Variant.Outlined">
                        @foreach (var user in _users)
                        {
                            <MudSelectItem T="int" Value="@user.Id">@user.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.body2" Class="muted">
                        Current session user: @CurrentUserName
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync">Save settings</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="ConnectSteamForCurrentUser" Disabled="@(!_hasCurrentUser)">
                            Sign in with Steam
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="ApplyThemePreset">Apply style preset</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudStack Spacing="3">
                <MudPaper Elevation="1" Class="pa-5">
                    <MudText Typo="Typo.h6">Customization</MudText>
                    <MudText Typo="Typo.body2" Class="muted mt-1">
                        Tune the colors used across planner kinds and game statuses.
                    </MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-3">
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.DateIdeaColor)">Date idea</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.ReminderColor)">Reminder</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.CountdownColor)">Countdown</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.MemoryColor)">Memory</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.GotTogetherColor)">Got together</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.WantToPlayColor)">Want to play</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.PlayingColor)">Playing</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.PlayedColor)">Played</MudChip>
                        <MudChip T="string" Variant="Variant.Filled" Style="@ChipStyle(_settings.FinishedColor)">Finished</MudChip>
                    </MudStack>
                    <MudGrid Spacing="2" Class="mt-3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.DateIdeaColor" Label="Date ideas" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.ReminderColor" Label="Reminders" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.MemoryColor" Label="Memories" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.CountdownColor" Label="Countdowns" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.GotTogetherColor" Label="Got together" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.WantToPlayColor" Label="Want to play" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.PlayingColor" Label="Playing" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.PlayedColor" Label="Played" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_settings.FinishedColor" Label="Finished" Variant="Variant.Outlined" InputType="InputType.Color" />
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Outlined" OnClick="ResetCustomization">Reset colors</MudButton>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-5">
                    <MudText Typo="Typo.h6">Add or update user</MudText>
                    <MudStack Spacing="2" Class="mt-3">
                        <MudTextField @bind-Value="_draft.Name" Label="Name" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_draft.AccentColor" Label="Accent color" Variant="Variant.Outlined" InputType="InputType.Color" />
                        <MudTextField @bind-Value="_draft.SteamId64Text"
                                      Label="Steam ID64"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Number" />
                        <MudCheckBox @bind-Value="_draft.IsDefault" Label="Default user" />
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveUserAsync">
                                @(_draft.Id == 0 ? "Add user" : "Update user")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="ResetDraft">Reset</MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="1" Class="pa-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">Users</MudText>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@_users.Count</MudChip>
        </MudStack>

        <MudGrid Spacing="2" Class="mt-2">
            @foreach (var user in _users)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="0" Class="user-card pa-4">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <div class="swatch" style="@($"background:{user.AccentColor}")"></div>
                                <MudText Typo="Typo.subtitle1">@user.Name</MudText>
                            </MudStack>
                            <MudText Typo="Typo.body2" Class="muted">@user.AccentColor</MudText>
                            <MudText Typo="Typo.body2" Class="muted">
                                @(string.IsNullOrWhiteSpace(user.SteamId64) ? "Steam not connected" : $"Steam ID64: {user.SteamId64}")
                            </MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => EditUser(user)">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ConnectSteamForUser(user.Id)">Connect Steam</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteUserAsync(user.Id)">Delete</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <MudAlert Severity="@_messageSeverity" Variant="Variant.Outlined" Class="mt-4">
                @_message
            </MudAlert>
        }
    </MudPaper>
</MudStack>

@code {
    private readonly SettingsDraft _draft = new();
    private readonly SharedSettingsDraft _settings = new();
    private List<PlannerUser> _users = [];
    private string _message = string.Empty;
    private Severity _messageSeverity = Severity.Info;
    private bool _hasCurrentUser;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnPlannerStateChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _users = (await Api.GetUsersAsync()).ToList();
        var settings = await Api.GetSettingsAsync();
        _settings.Apply(settings);
        _hasCurrentUser = State.SelectedUserId.HasValue && _users.Any(user => user.Id == State.SelectedUserId.Value);
        _settings.Theme = State.ThemeMode == "system" ? settings.Theme : State.ThemeMode;

        ApplySteamQueryMessage();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveSettingsAsync()
    {
        await Api.SaveSettingsAsync(new PlannerSettings
        {
            CoupleName = _settings.CoupleName.Trim(),
            RelationshipStart = _settings.RelationshipStart,
            DefaultReminderDays = _settings.DefaultReminderDays,
            Theme = _settings.Theme,
            VisualTheme = _settings.VisualTheme,
            ActiveUserId = _settings.ActiveUserId,
            RawgApiKey = string.IsNullOrWhiteSpace(_settings.RawgApiKey) ? null : _settings.RawgApiKey.Trim(),
            SteamWebApiKey = string.IsNullOrWhiteSpace(_settings.SteamWebApiKey) ? null : _settings.SteamWebApiKey.Trim(),
            DateIdeaColor = _settings.DateIdeaColor,
            ReminderColor = _settings.ReminderColor,
            MemoryColor = _settings.MemoryColor,
            CountdownColor = _settings.CountdownColor,
            GotTogetherColor = _settings.GotTogetherColor,
            WantToPlayColor = _settings.WantToPlayColor,
            PlayingColor = _settings.PlayingColor,
            PlayedColor = _settings.PlayedColor,
            FinishedColor = _settings.FinishedColor
        });

        State.ThemeMode = _settings.Theme;
        State.NotifyChanged();
        _messageSeverity = Severity.Success;
        _message = "Settings saved.";
        await LoadAsync();
    }

    private void ApplyThemePreset()
    {
        ApplyThemePreset(_settings.VisualTheme);
        _messageSeverity = Severity.Info;
        _message = $"Applied the {_settings.VisualTheme} style preset.";
    }

    private void OnVisualThemeChanged(string value)
    {
        _settings.VisualTheme = value;
        ApplyThemePreset(value);
    }

    private async Task SaveUserAsync()
    {
        if (string.IsNullOrWhiteSpace(_draft.Name))
        {
            _messageSeverity = Severity.Warning;
            _message = "Give the user a name first.";
            return;
        }

        var saved = await Api.SaveUserAsync(new PlannerUser
        {
            Id = _draft.Id,
            Name = _draft.Name.Trim(),
            AccentColor = string.IsNullOrWhiteSpace(_draft.AccentColor) ? "#c3252d" : _draft.AccentColor,
            SteamId64 = string.IsNullOrWhiteSpace(_draft.SteamId64Text) ? null : _draft.SteamId64Text.Trim(),
            IsDefault = _draft.IsDefault
        });

        if (!State.SelectedUserId.HasValue)
        {
            State.SelectedUserId = saved.Id;
            await Session.SetCurrentUserIdAsync(saved.Id);
        }

        _messageSeverity = Severity.Success;
        _message = "User saved.";
        ResetDraft();
        await LoadAsync();
    }

    private void ConnectSteamForCurrentUser()
    {
        if (State.SelectedUserId.HasValue)
        {
            ConnectSteamForUser(State.SelectedUserId.Value);
        }
    }

    private void ConnectSteamForUser(int userId)
    {
        if (userId <= 0)
        {
            return;
        }

        Navigation.NavigateTo($"/auth/steam/start?userId={userId}", forceLoad: true);
    }

    private void ResetCustomization()
    {
        ApplyThemePreset("persona");
        _settings.VisualTheme = "persona";
    }

    private string CurrentUserName =>
        State.SelectedUserId.HasValue
            ? _users.FirstOrDefault(user => user.Id == State.SelectedUserId.Value)?.Name ?? "Unknown user"
            : "No current user selected";

    private void ApplySteamQueryMessage()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (!query.TryGetValue("steam", out var steamStatus))
        {
            return;
        }

        _messageSeverity = string.Equals(steamStatus, "connected", StringComparison.OrdinalIgnoreCase)
            ? Severity.Success
            : Severity.Error;

        if (string.Equals(steamStatus, "connected", StringComparison.OrdinalIgnoreCase))
        {
            _message = "Steam account connected.";
            return;
        }

        _message = query.TryGetValue("message", out var message)
            ? message.ToString()
            : "Steam sign-in did not complete.";
    }

    private void EditUser(PlannerUser user)
    {
        _draft.Id = user.Id;
        _draft.Name = user.Name;
        _draft.AccentColor = user.AccentColor;
        _draft.SteamId64Text = user.SteamId64 ?? string.Empty;
        _draft.IsDefault = user.IsDefault;
    }

    private async Task DeleteUserAsync(int id)
    {
        var removingCurrentUser = State.SelectedUserId == id;
        await Api.DeleteUserAsync(id);
        if (removingCurrentUser)
        {
            State.SelectedUserId = null;
            await Session.ClearAsync();
        }
        _messageSeverity = Severity.Info;
        _message = "User removed.";
        await LoadAsync();
    }

    private void ResetDraft()
    {
        _draft.Id = 0;
        _draft.Name = string.Empty;
        _draft.AccentColor = "#c3252d";
        _draft.SteamId64Text = string.Empty;
        _draft.IsDefault = false;
    }

    private sealed class SettingsDraft
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string AccentColor { get; set; } = "#c3252d";
        public string SteamId64Text { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
    }

    private sealed class SharedSettingsDraft
    {
        public string CoupleName { get; set; } = "Us";
        public DateOnly? RelationshipStart { get; set; }
        public int DefaultReminderDays { get; set; } = 7;
        public string Theme { get; set; } = "system";
        public int ActiveUserId { get; set; } = 1;
        public string RawgApiKey { get; set; } = string.Empty;
        public string SteamWebApiKey { get; set; } = string.Empty;
        public string VisualTheme { get; set; } = "persona";
        public string DateIdeaColor { get; set; } = "#c3252d";
        public string ReminderColor { get; set; } = "#8d1117";
        public string MemoryColor { get; set; } = "#8f5c24";
        public string CountdownColor { get; set; } = "#6f3db8";
        public string GotTogetherColor { get; set; } = "#d14b75";
        public string WantToPlayColor { get; set; } = "#3b6ea8";
        public string PlayingColor { get; set; } = "#b56b16";
        public string PlayedColor { get; set; } = "#3f7a46";
        public string FinishedColor { get; set; } = "#6c4f95";

        public string? RelationshipStartText
        {
            get => RelationshipStart?.ToString("yyyy-MM-dd");
            set
            {
                if (DateOnly.TryParse(value, out var parsed))
                {
                    RelationshipStart = parsed;
                }
                else
                {
                    RelationshipStart = null;
                }
            }
        }

        public string DefaultReminderDaysText
        {
            get => DefaultReminderDays.ToString();
            set
            {
                if (int.TryParse(value, out var parsed))
                {
                    DefaultReminderDays = parsed;
                }
            }
        }

        public void Apply(PlannerSettings settings)
        {
            CoupleName = settings.CoupleName;
            RelationshipStart = settings.RelationshipStart;
            DefaultReminderDays = settings.DefaultReminderDays;
            Theme = settings.Theme;
            ActiveUserId = settings.ActiveUserId;
            RawgApiKey = settings.RawgApiKey ?? string.Empty;
            SteamWebApiKey = settings.SteamWebApiKey ?? string.Empty;
            VisualTheme = settings.VisualTheme;
            DateIdeaColor = settings.DateIdeaColor;
            ReminderColor = settings.ReminderColor;
            MemoryColor = settings.MemoryColor;
            CountdownColor = settings.CountdownColor;
            GotTogetherColor = settings.GotTogetherColor;
            WantToPlayColor = settings.WantToPlayColor;
            PlayingColor = settings.PlayingColor;
            PlayedColor = settings.PlayedColor;
            FinishedColor = settings.FinishedColor;
        }
    }

    private void ApplyThemePreset(string theme)
    {
        switch (theme)
        {
            case "rwby":
                _settings.DateIdeaColor = "#c3252d";
                _settings.ReminderColor = "#8f1118";
                _settings.MemoryColor = "#d6a643";
                _settings.CountdownColor = "#5c4ea4";
                _settings.GotTogetherColor = "#f07aa0";
                _settings.WantToPlayColor = "#1f3c88";
                _settings.PlayingColor = "#8f5b12";
                _settings.PlayedColor = "#b03030";
                _settings.FinishedColor = "#6a5acd";
                break;
            case "pokemon":
                _settings.DateIdeaColor = "#3b82f6";
                _settings.ReminderColor = "#1d4ed8";
                _settings.MemoryColor = "#f59e0b";
                _settings.CountdownColor = "#2563eb";
                _settings.GotTogetherColor = "#ec4899";
                _settings.WantToPlayColor = "#f97316";
                _settings.PlayingColor = "#facc15";
                _settings.PlayedColor = "#22c55e";
                _settings.FinishedColor = "#8b5cf6";
                break;
            case "dnd":
                _settings.DateIdeaColor = "#7c2d12";
                _settings.ReminderColor = "#991b1b";
                _settings.MemoryColor = "#92400e";
                _settings.CountdownColor = "#4c1d95";
                _settings.GotTogetherColor = "#b45309";
                _settings.WantToPlayColor = "#1e3a8a";
                _settings.PlayingColor = "#b91c1c";
                _settings.PlayedColor = "#166534";
                _settings.FinishedColor = "#6d28d9";
                break;
            case "cozy":
                _settings.DateIdeaColor = "#d97706";
                _settings.ReminderColor = "#b45309";
                _settings.MemoryColor = "#a16207";
                _settings.CountdownColor = "#8b5cf6";
                _settings.GotTogetherColor = "#f472b6";
                _settings.WantToPlayColor = "#fb7185";
                _settings.PlayingColor = "#f59e0b";
                _settings.PlayedColor = "#4ade80";
                _settings.FinishedColor = "#a78bfa";
                break;
            case "retro":
                _settings.DateIdeaColor = "#0ea5e9";
                _settings.ReminderColor = "#ef4444";
                _settings.MemoryColor = "#f97316";
                _settings.CountdownColor = "#8b5cf6";
                _settings.GotTogetherColor = "#ec4899";
                _settings.WantToPlayColor = "#06b6d4";
                _settings.PlayingColor = "#f43f5e";
                _settings.PlayedColor = "#22c55e";
                _settings.FinishedColor = "#eab308";
                break;
            default:
                _settings.DateIdeaColor = "#c3252d";
                _settings.ReminderColor = "#8d1117";
                _settings.MemoryColor = "#8f5c24";
                _settings.CountdownColor = "#6f3db8";
                _settings.GotTogetherColor = "#d14b75";
                _settings.WantToPlayColor = "#3b6ea8";
                _settings.PlayingColor = "#b56b16";
                _settings.PlayedColor = "#3f7a46";
                _settings.FinishedColor = "#6c4f95";
                break;
        }
    }

    private static string ChipStyle(string color) => $"background:{color};color:#fff;";

    private void OnPlannerStateChanged()
    {
        _ = LoadAsync();
    }

    public void Dispose()
    {
        State.Changed -= OnPlannerStateChanged;
    }
}

