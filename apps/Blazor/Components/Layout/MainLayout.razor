@inherits LayoutComponentBase
@implements IDisposable
@inject PlannerRepository Repository
@inject PlannerState State
@inject UserSessionService Session
@inject NavigationManager Navigation

<MudThemeProvider @ref="_themeProvider"
                  Theme="_theme"
                  IsDarkMode="_isDarkMode"
                  IsDarkModeChanged="OnDarkModeChanged"
                  ObserveSystemDarkModeChange="@(_themeMode == "system")" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@LayoutClass">
    <MudAppBar Elevation="1" Color="Color.Surface" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="app-title">Relationship Planner</MudText>
        <MudSpacer />
        <MudIconButton Icon="@ThemeIcon" Color="Color.Primary" OnClick="ToggleThemeAsync" />
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                   OnClick="OpenUserPicker">
            @CurrentUserButtonLabel
        </MudButton>
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" OpenChanged="OnDrawerChanged" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Lg" Elevation="1">
        <div class="drawer-brand">
            <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.Favorite" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle1" Class="drawer-title">Relationship Planner</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Shared calendar and personal profiles</MudText>
            </div>
        </div>

        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="planner" Icon="@Icons.Material.Filled.CalendarMonth">Planner</MudNavLink>
            <MudNavLink Href="finance" Icon="@Icons.Material.Filled.AccountBalanceWallet">Finance</MudNavLink>
            <MudNavLink Href="games" Icon="@Icons.Material.Filled.SportsEsports">Games</MudNavLink>
            <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="app-shell">
            @Body
        </MudContainer>
    </MudMainContent>

    <MudOverlay Visible="_showUserPicker" DarkBackground="true" Class="user-picker-overlay">
        <MudPaper Elevation="4" Class="user-picker-card pa-6">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h5">Choose who is using the app</MudText>
                    <MudText Typo="Typo.body2" Class="muted">
                        This browser session will remember your choice until you switch user or close the session.
                    </MudText>
                </MudStack>

                @if (_users.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        No users exist yet. Open Settings to create one first.
                    </MudAlert>
                }
                else
                {
                    <MudGrid Spacing="2">
                        @foreach (var user in _users)
                        {
                            <MudItem xs="12" sm="6">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="user-picker-button"
                                           OnClick="() => SelectUserAsync(user.Id)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <div class="swatch" style="@($"background:{user.AccentColor}")"></div>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@user.Name</MudText>
                                            <MudText Typo="Typo.body2" Class="muted">
                                                @(string.IsNullOrWhiteSpace(user.SteamId64) ? "Steam not connected" : "Steam connected")
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudButton>
                            </MudItem>
                        }
                    </MudGrid>
                }

                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="muted">
                        You can switch user later from the top bar.
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ManageUsers">
                        Manage users
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudOverlay>
</MudLayout>

@code {
    private const string LightMode = "light";
    private const string DarkMode = "dark";
    private const string SystemMode = "system";

    private MudThemeProvider? _themeProvider;
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private string _themeMode = SystemMode;
    private string _visualTheme = "persona";
    private bool _showUserPicker = true;
    private bool _sessionLoaded;
    private List<PlannerUser> _users = [];
    private PlannerSettings _settings = new();
    private MudTheme _theme = CreateTheme(new PlannerSettings(), false);

    private string LayoutClass => $"planner-shell {(_isDarkMode ? "dark-mode" : "light-mode")} theme-{_visualTheme}";

    private string ThemeIcon => _isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;

    private string CurrentUserButtonLabel =>
        _users.FirstOrDefault(user => user.Id == State.SelectedUserId)?.Name ?? "Select user";

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnPlannerStateChanged;
        _settings = await Repository.GetSettingsAsync();
        _users = (await Repository.GetUsersAsync()).ToList();
        _themeMode = NormalizeTheme(_settings.Theme);
        _visualTheme = NormalizeVisualTheme(_settings.VisualTheme);
        _theme = CreateTheme(_settings, _isDarkMode);
        State.ThemeMode = _themeMode;
        ApplyThemeMode(_settings.Theme);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RestoreCurrentUserAsync();
        }

        if (firstRender && _themeMode == SystemMode && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        _themeMode = _isDarkMode ? LightMode : DarkMode;
        _isDarkMode = !_isDarkMode;
        await PersistThemeAsync();
    }

    private async Task OnDarkModeChanged(bool value)
    {
        if (_isDarkMode == value)
        {
            return;
        }

        _isDarkMode = value;
        if (_themeMode == SystemMode)
        {
            return;
        }

        await PersistThemeAsync();
    }

    private async Task PersistThemeAsync()
    {
        _settings.Theme = _themeMode;
        _theme = CreateTheme(_settings, _isDarkMode);
        await Repository.SaveSettingsAsync(_settings);
        State.ThemeMode = _themeMode;
        State.NotifyChanged();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyThemeMode(string theme)
    {
        _themeMode = NormalizeTheme(theme);
        _isDarkMode = _themeMode switch
        {
            DarkMode => true,
            LightMode => false,
            _ => false
        };
        _theme = CreateTheme(_settings, _isDarkMode);
    }

    private static string NormalizeTheme(string theme) =>
        theme switch
        {
            DarkMode => DarkMode,
            LightMode => LightMode,
            _ => SystemMode
        };

    private static string NormalizeVisualTheme(string theme) =>
        theme switch
        {
            "persona" => "persona",
            "rwby" => "rwby",
            "pokemon" => "pokemon",
            "dnd" => "dnd",
            "cozy" => "cozy",
            "retro" => "retro",
            _ => "persona"
        };

    private static MudTheme CreateTheme(PlannerSettings settings, bool darkMode)
    {
        var primary = settings.DateIdeaColor;
        var secondary = settings.GotTogetherColor;
        var surface = darkMode ? "#141a27" : "#ffffff";
        var background = darkMode ? "#0d1018" : "#eef1f6";

        return new MudTheme
        {
            PaletteLight = new PaletteLight
            {
                Primary = primary,
                Secondary = secondary,
                Surface = surface,
                Background = background,
                AppbarBackground = surface,
                AppbarText = darkMode ? "#f6f7fb" : "#12131a",
                DrawerBackground = surface,
                DrawerText = darkMode ? "#f6f7fb" : "#12131a",
                TextPrimary = darkMode ? "#f6f7fb" : "#12131a",
                TextSecondary = darkMode ? "#a8afbf" : "#5f6675"
            },
            PaletteDark = new PaletteDark
            {
                Primary = primary,
                Secondary = secondary,
                Surface = "#141a27",
                Background = "#0d1018",
                AppbarBackground = "#111622",
                AppbarText = "#f6f7fb",
                DrawerBackground = "#111622",
                DrawerText = "#f6f7fb",
                TextPrimary = "#f6f7fb",
                TextSecondary = "#a8afbf"
            }
        };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private Task OnDrawerChanged(bool value)
    {
        _drawerOpen = value;
        return Task.CompletedTask;
    }

    private void OpenUserPicker() => _showUserPicker = true;

    private void ManageUsers()
    {
        _showUserPicker = false;
        Navigation.NavigateTo("/settings");
    }

    private async Task SelectUserAsync(int userId)
    {
        State.SelectedUserId = userId;
        _showUserPicker = false;
        await Session.SetCurrentUserIdAsync(userId);
        State.NotifyChanged();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreCurrentUserAsync()
    {
        if (_sessionLoaded)
        {
            return;
        }

        _sessionLoaded = true;

        var storedUserId = await Session.GetCurrentUserIdAsync();
        if (storedUserId.HasValue && _users.Any(user => user.Id == storedUserId.Value))
        {
            State.SelectedUserId = storedUserId.Value;
            _showUserPicker = false;
        }
        else
        {
            State.SelectedUserId = null;
            _showUserPicker = true;
        }

        State.NotifyChanged();
        await InvokeAsync(StateHasChanged);
    }

    private void OnPlannerStateChanged()
    {
        _ = RefreshShellAsync();
    }

    private async Task RefreshShellAsync()
    {
        _settings = await Repository.GetSettingsAsync();
        _users = (await Repository.GetUsersAsync()).ToList();
        _visualTheme = NormalizeVisualTheme(_settings.VisualTheme);
        _theme = CreateTheme(_settings, _isDarkMode);
        await SyncThemeFromStateAsync();
    }

    private async Task SyncThemeFromStateAsync()
    {
        _themeMode = NormalizeTheme(State.ThemeMode);
        if (_themeMode == SystemMode && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
        }
        else
        {
            _isDarkMode = _themeMode == DarkMode;
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.Changed -= OnPlannerStateChanged;
    }
}

