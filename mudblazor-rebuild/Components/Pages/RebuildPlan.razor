@page "/rebuild-plan"

<PageTitle>Rebuild Plan</PageTitle>

<MudStack Spacing="3">
    <MudPaper Elevation="1" Class="pa-5">
        <MudText Typo="Typo.h4">Rebuild plan</MudText>
        <MudText Typo="Typo.body1" Class="muted mt-2">
            The idea is to migrate the existing relationship planner into this Blazor project in stages.
        </MudText>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudCard Class="roadmap-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6">UI foundation</MudText>
                    <MudText Typo="Typo.body2">Landing page, app shell, drawer navigation, and theme tokens.</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Class="roadmap-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Persistence layer</MudText>
                    <MudText Typo="Typo.body2">SQLite-backed storage with service classes and future sync hooks.</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Class="roadmap-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Planner workflows</MudText>
                    <MudText Typo="Typo.body2">Dates, countdowns, reminders, and the relationship timeline.</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Class="roadmap-card">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Polish and mobile UX</MudText>
                    <MudText Typo="Typo.body2">Responsive layout, touch-friendly controls, and visual hierarchy.</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudStack>
